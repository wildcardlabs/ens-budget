{
  "name": "@namepass/ens-budget",
  "version": "0.1.0",
  "description": "Budget-first ENS v2 renewals: turn a stablecoin budget into the longest renewal it buys, then renew.",
  "license": "MIT",
  "author": "Namepass LLC <steve@namepass.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildcardlabs/ens-budget.git"
  },
  "homepage": "https://github.com/wildcardlabs/ens-budget#readme",
  "bugs": "https://github.com/wildcardlabs/ens-budget/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "keywords": [
    "ens",
    "ensv2",
    "renewal",
    "viem",
    "usdc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "ENS_BUDGET_LIVE=1 vitest run test/live.test.ts",
    "test:fork": "ENS_BUDGET_FORK=1 vitest run test/fork.test.ts",
    "size": "esbuild src/index.ts --bundle --minify --format=esm --external:viem --log-level=warning | wc -c",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "viem": "^2.38.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
